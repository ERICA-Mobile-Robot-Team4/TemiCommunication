<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FAF0E6">

    <TextView
        android:id="@+id/txtHint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="집사의 방을 수색하세요."
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:padding="20dp"
        android:layout_marginBottom="24dp"
        android:maxLines="50"
        android:scrollbars="vertical"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/layoutClueContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2"
        android:visibility="gone"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/txtClueLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:textSize="22sp"
            android:textColor="#2D1B18"
            android:lineSpacingMultiplier="1.3"
            android:scrollbars="vertical"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/txtClueRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:textSize="22sp"
            android:textColor="#2D1B18"
            android:lineSpacingMultiplier="1.3"
            android:scrollbars="vertical"
            android:visibility="gone"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVoiceStart"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:text="🎙️ 정답 말하기 (버튼 클릭)"
        android:textSize="24sp"
        android:textStyle="bold"
        android:backgroundTint="#A1887F"
        android:textColor="#FFFFFF"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp"
        android:paddingHorizontal="32dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutHintOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ 인증 실패. 힌트를 받으시겠습니까?"
            android:textSize="24sp"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnHint1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="① -5점  : 어려운 힌트"
            android:textSize="20sp"
            android:backgroundTint="#B0BEC5"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHint2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="② -10점 : 보통 힌트"
            android:textSize="20sp"
            android:backgroundTint="#B0BEC5"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHint3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="③ -15점 : 쉬운 힌트"
            android:textSize="20sp"
            android:backgroundTint="#B0BEC5"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnHint4"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:backgroundTint="#CFD8DC"
            android:text="④ 힌트 없이 재시도"
            android:textSize="20sp"/>
    </LinearLayout>
</LinearLayout>