<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutMission1_4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0B0E14">

    <!-- LEFT SIDEBAR : Mission3 스타일 -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:background="#131722"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="45dp"
            android:clickable="true"
            android:focusable="true"
            android:text="≡"
            android:textColor="#D4AF37"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👥"
                android:textColor="#566275"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="WHO"
                android:textColor="#566275"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="35dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="45dp"
                android:background="#D4AF37" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📜"
                    android:textColor="#D4AF37"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="CLUE"
                    android:textColor="#D4AF37"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="#2C3038" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄"
                android:textColor="#566275"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="FILE"
                android:textColor="#566275"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- RIGHT CONTENT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#0B0E14">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="THE MOURNING ESTATE"
                android:textColor="#D4AF37"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="150dp"
                android:layout_height="32dp"
                android:background="#4B1F24"
                android:gravity="center"
                android:text="● LIVE MONITORING"
                android:textColor="#FFD6D1"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MAIN PANEL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#151922"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="TERMINAL 04"
                android:textColor="#D4AF37"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Analysis"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />



            <!-- 사진 + 선택지 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- 사건 현장 이미지 -->

                <!-- 선택지 -->
                <ImageView
                    android:id="@+id/imgEvidenceScene"
                    android:layout_width="659dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.45"
                    android:background="#10131A"
                    android:padding="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/evidence" />

                <LinearLayout
                    android:layout_width="267dp"
                    android:layout_height="304dp"
                    android:layout_marginStart="24dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btnChoice1"
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:backgroundTint="#1C1E26"
                        android:text="① 책상 위 먼지 흔적"
                        android:textColor="#F2C84B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnChoice2"
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="18dp"
                        android:backgroundTint="#1C1E26"
                        android:text="② 벽난로 앞 혈흔"
                        android:textColor="#F2C84B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnChoice3"
                        android:layout_width="236dp"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#1C1E26"
                        android:text="③ 책장 앞 바닥 긁힘 자국"
                        android:textColor="#F2C84B"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/textResult"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:padding="20dp"
                android:background="#10131A"
                android:text=""
                android:textColor="#F2C84B"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:text="REF: LIBRARY-EVIDENCE-04        SYSTEM ONLINE        VER. 4.2.0"
            android:textColor="#5A4A36"
            android:textSize="9sp" />

    </LinearLayout>

</LinearLayout>