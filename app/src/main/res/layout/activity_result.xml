<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- 배경 오버레이 -->
    <View
        android:id="@+id/overlayBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000" />

    <!-- 메인 콘텐츠 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 왼쪽: 용의자 사진 + 판정 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <!-- 판정 배지 -->
            <TextView
                android:id="@+id/tvVerdict"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사건 해결"
                android:textColor="#D4AF37"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:background="#1A1400"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="20dp" />

            <!-- 용의자 사진 -->
            <ImageView
                android:id="@+id/imgSuspect"
                android:layout_width="180dp"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:background="#111111" />

            <!-- 이름 -->
            <TextView
                android:id="@+id/tvSuspectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="강병철"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <!-- 신분 -->
            <TextView
                android:id="@+id/tvSuspectRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="집사 · 58세"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- 오른쪽: 결과 내용 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical"
            android:padding="36dp"
            android:gravity="center_vertical">

            <!-- 결과 타이틀 -->
            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦ 블랙우드 저택의 밤 — 수사 종결"
                android:textColor="#C8A96E"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvResultHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="사건 해결!"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvResultSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="당신은 진범을 찾아냈습니다."
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- 구분선 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginBottom="24dp" />

            <!-- 진실 내용 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 진실 ]"
                android:textColor="#C8A96E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvTruth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#D8D8D8"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <!-- 버튼 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start">

                <Button
                    android:id="@+id/btnBackToMain"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="메인으로"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#2A2A2A"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btnRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="다시 심문"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#8B1E1E" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
