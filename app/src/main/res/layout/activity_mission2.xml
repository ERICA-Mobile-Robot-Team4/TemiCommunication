<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0F1218">

    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#131722"
        android:gravity="center_horizontal"
        android:paddingTop="30dp"
        android:paddingBottom="20dp">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="≡"
            android:textColor="#D4AF37"
            android:textSize="26sp"
            android:layout_marginBottom="45dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="30dp">
            <View
                android:layout_width="4dp"
                android:layout_height="45dp"
                android:background="#D4AF37"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textColor="#D4AF37"
                    android:textSize="16sp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHO"
                    android:textColor="#D4AF37"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnClue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="30dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜"
                android:textColor="#566275"
                android:textSize="16sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLUE"
                android:textColor="#566275"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOGS"
            android:textColor="#566275"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/txtHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE MOURNING ESTATE"
                android:textColor="#D4AF37"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION TIME  00:45:12"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/layoutMainPlayArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="10"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/layoutArchiveGrid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="6.5"
                    android:orientation="vertical"
                    android:weightSum="2"
                    android:layout_marginEnd="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginBottom="12dp">
                        <LinearLayout
                            android:id="@+id/panelCharles"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#131722"
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ARCHIVE #01"
                                android:textColor="#566275"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="찰스 블랙우드"
                                android:textColor="#D4AF37"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>
                            <TextView
                                android:id="@+id/txtCharlesContent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="#E3DCCB"
                                android:textSize="14sp"
                                android:lineSpacingMultiplier="1.3"
                                android:scrollbars="vertical"
                                android:text="처음으로 저택 정원에 씨앗이 뿌려졌다.\n\&quot;힘만으로는 사람의 마음을\n 얻을 수 없다는 것을 알았노라\&quot;\n\n후대 사람들은 그를 이렇게 불렀다:\n\&quot;────의 사나이\&quot;" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/panelEdward"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#131722"
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ARCHIVE #02"
                                android:textColor="#566275"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="에드워드 블랙우드"
                                android:textColor="#D4AF37"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>
                            <TextView
                                android:id="@+id/txtEdwardContent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="#E3DCCB"
                                android:textSize="14sp"
                                android:lineSpacingMultiplier="1.3"
                                android:scrollbars="vertical"
                                android:text="땅 위의 것에 만족하지 않았다.\n저택 가장 높은 곳에 올라\n지평선 너머를 바라보며 말했다:\n\&quot;저 너머에도 우리의 것이 있다\&quot;\n\n후대 사람들은 그를 이렇게 불렀다:\n\&quot;────의 사나이\&quot;" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:weightSum="2"
                        android:layout_marginTop="4dp">
                        <LinearLayout
                            android:id="@+id/panelHenry"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#131722"
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ARCHIVE #03"
                                android:textColor="#566275"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="헨리 블랙우드"
                                android:textColor="#D4AF37"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>
                            <TextView
                                android:id="@+id/txtHenryContent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="#E3DCCB"
                                android:textSize="14sp"
                                android:lineSpacingMultiplier="1.3"
                                android:scrollbars="vertical"
                                android:text="재임 기간, 저택은 단 한 번도\n외부의 침략을 허용하지 않았다.\n\&quot;형이 쌓은 것을 절대 잃지 않겠다\&quot;\n\n후대 사람들은 그를 이렇게 불렀다:\n\&quot;────의 사나이\&quot;" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/panelWilliam"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#131722"
                            android:padding="16dp"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ARCHIVE #04"
                                android:textColor="#566275"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="윌리엄 블랙우드"
                                android:textColor="#D4AF37"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:layout_marginBottom="8dp"/>
                            <TextView
                                android:id="@+id/txtWilliamContent"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:textColor="#E3DCCB"
                                android:textSize="14sp"
                                android:lineSpacingMultiplier="1.3"
                                android:scrollbars="vertical"
                                android:text="죽는 날까지 단 한 번도\n협상 테이블에 앉지 않았다.\n원하는 것을 언제나\n직접 손으로 가져갔다.\n\n후대 사람들은 그를 이렇게 불렀다:\n\&quot;────의 사나이\&quot;" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3.5"
                    android:orientation="vertical"
                    android:background="#131722"
                    android:padding="18dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HINT &amp; STATUS"
                            android:textColor="#566275"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="⚙"
                            android:textColor="#8C1111"
                            android:textSize="14sp"/>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/txtWordPoolGuide"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:background="#1B2230"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="💡 HINT:\n\&quot;가문은 피로 시작되어 아름다움으로 끝났다.\n땅을 지킨 자는 개척자의 뒤를 따랐고,\n하늘을 바란 자는 수호자 다음에 섰다.\&quot;\n\n빈칸에 들어갈 단어의 순서대로 스위치를 누르시오."
                            android:textColor="#D4AF37"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.25"
                            android:letterSpacing="-0.02"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#000000"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 검"
                                android:textColor="#D4AF37"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="12dp"/>

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#2196F3"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 방패"
                                android:textColor="#D4AF37"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="12dp"/>

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#FFFFFF"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 독수리"
                                android:textColor="#D4AF37"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginEnd="12dp"/>

                            <View
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@android:drawable/presence_online"
                                android:backgroundTint="#E53935"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" 장미"
                                android:textColor="#D4AF37"
                                android:textSize="15sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#0A0C11"
                        android:padding="14dp"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CURRENT INPUT SEQUENCE"
                            android:textColor="#566275"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/txtInputStatus"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="[ 대기 중... ]"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:letterSpacing="0.02"
                            android:background="#131722"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnResetMission"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="#2C1B1B"
                        android:text="🔄 INPUT RESET"
                        android:textColor="#FF6B6B"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:letterSpacing="0.05"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginBottom="8dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#0A0C11"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROTOCOL: VINTAGE_ESTATE_V4"
                            android:textColor="#566275"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AUDIO_STREAM: 44.1kHz ENGAGED"
                            android:textColor="#4CAF50"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutClueContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:weightSum="2"
                android:visibility="gone">
                <TextView
                    android:id="@+id/txtClueLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:scrollbars="vertical"/>
                <TextView
                    android:id="@+id/txtClueRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="6dp"
                    android:scrollbars="vertical"/>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/txtStatusDashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#131722"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:padding="10dp"
            android:text="ANALYSIS ACTIVE: AWAITING SWITCH INPUT"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.05"/>
    </LinearLayout>
</LinearLayout>