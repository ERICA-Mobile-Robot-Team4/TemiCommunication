<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 미션 진행 화면 -->
    <LinearLayout
        android:id="@+id/layoutMissionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textMissionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕵️ Mission 3"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="혈흔 희석 흔적 재현 미션"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="35dp" />

        <TextView
            android:id="@+id/textTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="남은 시간 : --초"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:background="#FFF3E0"
            android:textColor="#BF360C" />

        <TextView
            android:id="@+id/textStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1단계 : 수위 조절"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:background="#F5F5F5" />

        <TextView
            android:id="@+id/textStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2단계 : 농도 조절"
            android:textSize="22sp"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginBottom="30dp"
            android:background="#F5F5F5" />

<!--        <TextView-->
<!--            android:id="@+id/textResult"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="최종 결과 : 대기 중"-->
<!--            android:textSize="24sp"-->
<!--            android:textStyle="bold"-->
<!--            android:gravity="center"-->
<!--            android:padding="20dp" />-->

    </LinearLayout>

    <!-- 단서 전용 화면 -->
    <LinearLayout
        android:id="@+id/layoutClueContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#EFEBE9"
        android:visibility="gone">

        <TextView
            android:id="@+id/textClueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📜 획득한 단서"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#2D1B18"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutClueTop"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtClueLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtClueRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:scrollbars="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtClueBottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>