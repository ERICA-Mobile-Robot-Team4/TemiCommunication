<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1218">

    <LinearLayout
        android:id="@+id/layoutMissionContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0E14"
        android:orientation="horizontal">

        <!-- LEFT SIDEBAR -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:background="#131722"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="30dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="45dp"
                android:clickable="true"
                android:focusable="true"
                android:text="≡"
                android:textColor="#D4AF37"
                android:textSize="26sp" />

            <LinearLayout
                android:id="@+id/btnWho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥"
                    android:textColor="#D4AF37"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="WHO"
                    android:textColor="#D4AF37"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="35dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="45dp"
                    android:background="#D4AF37" />

                <LinearLayout
                    android:id="@+id/btnClue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📜"
                        android:textColor="#D4AF37"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CLUE"
                        android:textColor="#D4AF37"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:background="#2C3038" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textColor="#566275"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="FILE"
                    android:textColor="#566275"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CENTER CONTENT -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- HEADER: 항상 보임 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="THE MOURNING ESTATE"
                    android:textColor="#D4AF37"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="32dp"
                    android:background="#4B1F24"
                    android:gravity="center"
                    android:text="● LIVE MONITORING"
                    android:textColor="#FFD6D1"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 화면 전환 영역 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7">

                <!-- 미션 패널 -->
                <LinearLayout
                    android:id="@+id/layoutMissionPanel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="18dp"
                    android:background="#151922"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="SCENE 4"
                        android:textColor="#D4AF37"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="지하실"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp">

                        <TextView
                            android:id="@+id/textTimer"
                            android:layout_width="210dp"
                            android:layout_height="60dp"
                            android:layout_centerInParent="true"
                            android:background="#1C1E26"
                            android:gravity="center"
                            android:text="남은 시간 : 30초"
                            android:textColor="#F2C84B"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textStep1"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="#1C1E26"
                            android:gravity="center"
                            android:padding="18dp"
                            android:text="1단계 : 수위 조절"
                            android:textColor="#F2C84B"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textStep2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="#211B1F"
                            android:gravity="center"
                            android:padding="18dp"
                            android:text="2단계 : 농도 조절"
                            android:textColor="#F2B0A8"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textResult"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:text=""
                        android:visibility="invisible" />

                </LinearLayout>

                <!-- 단서 패널 -->
                <LinearLayout
                    android:id="@+id/layoutClueContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="28dp"
                    android:background="#0B0E14"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textClueTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="획득한 단서"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#F2C84B"
                        android:layout_marginBottom="18dp" />

                    <LinearLayout
                        android:id="@+id/layoutClueTop"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtClueLeft"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="8dp"
                            android:scrollbars="vertical"
                            android:background="#151922"
                            android:textColor="#D8D2C2"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtClueRight"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_margin="8dp"
                            android:scrollbars="vertical"
                            android:background="#151922"
                            android:textColor="#D8D2C2"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtClueBottom"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:scrollbars="vertical"
                        android:background="#151922"
                        android:textColor="#D8D2C2"
                        android:visibility="gone" />

                </LinearLayout>

            </FrameLayout>

            <!-- FOOTER: 항상 보임 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:text="REF: KITCHEN-SINK-03        SYSTEM ONLINE        VER. 4.2.0"
                android:textColor="#5A4A36"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>